<Window x:Class="CodexUpdater.App.RgAdguardProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="正在检查更新"
        Width="420"
        Height="170"
        ResizeMode="NoResize"
        WindowStyle="None"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        Background="#E7EBE4"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        Foreground="{StaticResource InkBrush}">
    <Border Margin="1"
            Padding="22"
            Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource LineBrush}"
            BorderThickness="1"
            CornerRadius="8">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="正在通过 rg-adguard 获取安装包"
                       FontSize="17"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center" />
            <TextBlock Text="请勿关闭窗口"
                       Margin="0,7,0,0"
                       FontSize="13"
                       Foreground="{StaticResource MutedBrush}"
                       HorizontalAlignment="Center" />
            <ProgressBar Margin="0,18,0,0"
                         Height="8"
                         IsIndeterminate="True" />
        </StackPanel>
    </Border>
</Window>
