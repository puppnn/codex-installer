<Window x:Class="CodexUpdater.App.ErrorDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="操作未完成" Width="760" Height="480" MinWidth="420" MinHeight="300"
        WindowStartupLocation="CenterOwner" Background="{StaticResource PanelBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI" Foreground="{StaticResource InkBrush}">
    <Grid Margin="20" Background="{StaticResource PanelBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
            <RowDefinition Height="14" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="SummaryText" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBox x:Name="DetailsText" Grid.Row="2" IsReadOnly="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" Padding="10" FontSize="12" />
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="复制错误详情" Click="CopyButton_Click" Margin="0,0,10,0" />
            <Button Content="关闭" IsCancel="True" MinWidth="90" />
        </StackPanel>
    </Grid>
</Window>
